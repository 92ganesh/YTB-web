<?xml version="1.0" encoding="utf-8"?>
<!-- Two-card layout: browser card (WebView) + fullscreen card (video overlay).
     JAVA ANALOGY: CardLayout("browser") default; FullscreenHandler flips to
     CardLayout("video") by filling fullscreenContainer with YouTube's view. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- com.ytbweb.KeepAliveWebView: top-level class holding the visibility hack.
         Must match the class name exactly or findViewById crashes. -->
    <com.ytbweb.KeepAliveWebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Fullscreen card: GONE until YouTube requests fullscreen. Black bg so
         letterboxed video blends in (like setBackground(Color.BLACK)). -->
    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

</FrameLayout>
