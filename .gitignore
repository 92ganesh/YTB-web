# Android / Gradle ignores (keeps the repo small; CI regenerates these)
*.iml
.gradle/
local.properties
.idea/
.DS_Store
app/build/
app/release/
YtbNative/app/build/
**/build/
gradle/wrapper/gradle-wrapper.jar
# Telemetry history: archived per-build logs stay LOCAL (never pushed).
# The live telemetry.log is git-ignored too (it rewrites every second while
# the server runs — committing it would spam every git status).
telemetry.log
*.log
telemetry-history/
